# Leave these empty for the local, clearly labelled demonstration.
# Real shared mode requires BOTH values and the SQL migration in docs/DATABASE.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: force the browser-only demonstration, even when Supabase is configured.
# Never use this option for a workspace containing real business records.
NEXT_PUBLIC_DEMO_MODE=false

# Server only. A JSON object mapping each ERP company UUID to its Holded API v2 token.
# Do not prefix this variable with NEXT_PUBLIC_. Do not commit actual tokens.
# See docs/HOLDED.md. Remote invoice creation remains disabled in this version.
HOLDED_API_KEYS_JSON={}
